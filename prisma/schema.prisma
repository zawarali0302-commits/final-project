// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Enums ---

enum UserRole {
  SUPER_ADMIN
  ADMIN
  TEACHER
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum InstituteType {
  SCHOOL
  COLLEGE
  UNIVERSITY
}

enum StudentStatus {
  ACTIVE
  SUSPENDED
  GRADUATED
  WITHDRAWN
}

enum ProgramLevel {
  INTERMEDIATE
  UNDERGRADUATE
  POSTGRADUATE
}

enum ProgramSystem {
  ANNUAL
  SEMESTER
}

enum ExamType {
  MID
  FINAL
  QUIZ
  ASSIGNMENT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum EnrollmentStatus {
  ACTIVE
  DROPPED
  COMPLETED
  FAILED
}

// --- Core Models ---

model Institute {
  id        String        @id @default(cuid())
  name      String
  type      InstituteType
  location  String
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  users         User[]
  departments   Department[]
  academicYears AcademicYear[]
  sessions      Session[]
  students      Student[]
  teachers      Teacher[]
}

model User {
  id                  String    @id @default(cuid())
  clerkId             String?   @unique
  email               String    @unique
  password            String?
  role                UserRole
  instituteId         String?
  resetPasswordToken  String?
  resetTokenExpiresAt DateTime?
  isEmailVerified     Boolean   @default(false)
  lastLoginAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  institute Institute? @relation(fields: [instituteId], references: [id], onDelete: SetNull)
  teacher   Teacher?

  @@index([role, instituteId])
}

model AcademicYear {
  id          String    @id @default(cuid())
  name        String
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean   @default(false)
  instituteId String
  institute   Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  terms Term[]

  @@unique([name, instituteId])
}

// --- Academic Structure ---

model Department {
  id          String    @id @default(cuid())
  name        String
  code        String?
  instituteId String
  institute   Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  programs Program[]
  courses  Course[]
  teachers Teacher[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, instituteId])
}

model Program {
  id           String        @id @default(cuid())
  name         String
  level        ProgramLevel
  system       ProgramSystem
  departmentId String
  department   Department    @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  terms    Term[]
  students Student[]
  sessions Session[]

  @@unique([name, departmentId])
}

model Session {
  id          String    @id @default(cuid())
  name        String
  startYear   Int
  endYear     Int
  programId   String
  instituteId String
  program     Program   @relation(fields: [programId], references: [id], onDelete: Cascade)
  institute   Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  students  Student[]
  createdAt DateTime  @default(now())

  @@unique([name, programId])
  @@index([programId])
  @@map("Session")
}

model Term {
  id             String       @id @default(cuid())
  name           String
  startDate      DateTime?
  endDate        DateTime?
  programId      String
  program        Program      @relation(fields: [programId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  sections        Section[]
  courseOfferings CourseOffering[]

  @@unique([name, programId, academicYearId])
  @@map("Term")
}

// --- Sections & Courses ---

model Section {
  id     String @id @default(cuid())
  name   String
  termId String
  term   Term   @relation(fields: [termId], references: [id], onDelete: Cascade)

  studentEnrollments StudentEnrollment[]
  exams              Exam[]
  sectionCourses     SectionCourse[]

  @@unique([name, termId])
}

model Course {
  id           String     @id @default(cuid())
  name         String
  code         String
  credits      Int?
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  offerings CourseOffering[]

  @@unique([code, departmentId])
}

// --- Course Offering & Teaching ---

model CourseOffering {
  id       String @id @default(cuid())
  courseId String
  termId   String

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  term   Term   @relation(fields: [termId], references: [id], onDelete: Cascade)

  studentEnrollments StudentEnrollment[]
  exams              Exam[]
  sectionCourses     SectionCourse[]

  @@unique([courseId, termId])
}

model SectionCourse {
  id               String  @id @default(cuid())
  courseOfferingId String
  sectionId        String
  teacherId        String?

  courseOffering CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  section        Section        @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  teacher        Teacher?       @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  @@unique([courseOfferingId, sectionId])
}

// --- Teacher & Student Models ---

model Teacher {
  id           String     @id @default(cuid())
  name         String
  designation  String
  email        String     @unique
  instituteId  String
  departmentId String
  userId       String     @unique
  institute    Institute  @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  sectionCourses SectionCourse[]
}

model Student {
  id          String        @id @default(cuid())
  rollNo      String
  name        String
  gender      Gender
  status      StudentStatus @default(ACTIVE)
  instituteId String
  programId   String
  sessionId   String

  session   Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  program   Program   @relation(fields: [programId], references: [id], onDelete: Cascade)

  studentEnrollments StudentEnrollment[]

  @@unique([rollNo, instituteId])
}

// --- Enrollment & Attendance ---

model StudentEnrollment {
  id               String           @id @default(cuid())
  studentId        String
  courseOfferingId String
  enrollmentDate   DateTime         @default(now())
  status           EnrollmentStatus @default(ACTIVE)

  student        Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseOffering CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)

  attendances Attendance[]
  results     Result[]
  section     Section?     @relation(fields: [sectionId], references: [id])
  sectionId   String?

  @@unique([studentId, courseOfferingId])
}

model Attendance {
  id           String            @id @default(cuid())
  date         DateTime
  status       AttendanceStatus
  enrollmentId String
  enrollment   StudentEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, date])
}

// --- Exams & Results ---

model Exam {
  id               String         @id @default(cuid())
  type             ExamType
  title            String
  date             DateTime
  totalMarks       Float
  sectionId        String
  courseOfferingId String
  section          Section        @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  courseOffering   CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)

  results Result[]
}

model Result {
  id           String            @id @default(cuid())
  marks        Float
  grade        String?
  remarks      String?
  enrollmentId String
  examId       String
  enrollment   StudentEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  exam         Exam              @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, examId])
}
